{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Xiaoxi owner deployment v1",
  "type": "object",
  "required": [
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "account": {
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "maxLength": 128
        },
        "folder": {
          "type": "string",
          "maxLength": 128
        },
        "cacheRoot": {
          "type": "string",
          "maxLength": 1024
        },
        "wxid": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "character": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "name": {
          "type": "string",
          "maxLength": 64
        },
        "aliases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "maxLength": 64
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "name": {
            "type": "string",
            "maxLength": 128
          },
          "kind": {
            "enum": [
              "group",
              "contact"
            ]
          },
          "wechatPeerId": {
            "type": "string",
            "pattern": "^[0-9]{1,32}@chatroom$",
            "description": "Raw group cache ID, never a UIA AutomationId."
          }
        },
        "additionalProperties": false
      }
    },
    "native": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mediaCache": {
          "type": "boolean"
        },
        "allowModuleDataScan": {
          "type": "boolean"
        }
      }
    },
    "model": {
      "type": "object",
      "properties": {
        "provider": {
          "enum": [
            "mock",
            "compatible",
            "codex"
          ]
        },
        "model": {
          "type": "string",
          "maxLength": 100
        },
        "baseUrl": {
          "type": "string",
          "maxLength": 2048
        },
        "apiKeyEnv": {
          "type": "string",
          "maxLength": 128
        },
        "vision": {
          "type": "boolean"
        },
        "stream": {
          "type": "boolean"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 300000
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128000
        },
        "outputTokenField": {
          "enum": [
            "max_tokens",
            "max_completion_tokens"
          ]
        }
      }
    },
    "extensions": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "module"
        ],
        "properties": {
          "module": {
            "type": "string",
            "pattern": "^\\./plugins/.+\\.mjs$"
          },
          "options": {
            "type": "object"
          }
        }
      }
    }
  },
  "$comment": "Runtime additionally enforces unique IDs/names, native/media opt-in dependencies, endpoint/path validity and no inline API keys. Runtime windowBinding is not an owner configuration field. Internal session.peerId is a local target ID."
}
